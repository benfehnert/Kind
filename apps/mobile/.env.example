# Local dev — override with your staging Worker URL for remote testing
EXPO_PUBLIC_API_URL=http://localhost:4000
# EXPO_PUBLIC_API_URL=https://kind-api-staging.<subdomain>.workers.dev

# PostHog (EU) — project API key from https://eu.posthog.com/project/settings
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
