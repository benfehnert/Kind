PORT=4000

# Local Supabase (npx supabase start — run `npx supabase status` for keys)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<anon key from supabase status>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from supabase status>
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

OPENAI_API_KEY=

# Remote Supabase project refs — used by `npm run supabase:*` scripts to verify
# (and auto-relink, if needed) the linked project before touching a remote DB.
# staging branch → staging project, main branch → production project.
# Get project refs from Supabase dashboard → Project Settings → General.
SUPABASE_PROJECT_REF_STAGING=
SUPABASE_PROJECT_REF_PRODUCTION=

# Remote DB URLs — used by `npm run release:staging` and `npm run release:main`
# to auto-push DB migrations, and by the supabase:* guard script to auto-relink
# without an interactive password prompt. Use the Session pooler URL (not direct
# connection) to avoid port 5432 firewall issues.
# Supabase dashboard → Project Settings → Database → Connection string
# → Session pooler → URI
# Format: postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL_STAGING=
SUPABASE_DB_URL_PRODUCTION=

# true  → all Kind routes served from JSON mocks (no DB needed)
# false → Kind routes served from Supabase DB (requires supabase:start + seed:kind)
USE_MOCK_DATA=true

# Resend — data export request notifications (logs to console when RESEND_API_KEY is unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kind <notifications@kind-health.app>
DATA_EXPORT_NOTIFY_TO=hello@kind-health.app
