{
  "name": "kind-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "test:local": "node scripts/test-local.mjs",
    "run:local": "node scripts/run-local.mjs",
    "run:api": "npm --prefix apps/api run dev",
    "run:mobile": "npm --prefix apps/mobile run web",
    "run:website": "npm --prefix apps/kind-website run serve",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate:local": "npm --prefix apps/api run migrate",
    "release:staging": "node scripts/release.mjs staging",
    "release:main": "node scripts/release.mjs main"
  }
}